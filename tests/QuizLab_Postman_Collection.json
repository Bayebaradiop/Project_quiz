							"raw": "{\n  \"texte\": \"Quel est le plus grand océan du monde ?\",\n  \"duree\": 20,\n  \"ordre\": 3,\n  \"choix_reponses\": [\n    {\"texte\": \"Océan Atlantique\", \"est_correcte\": false, \"ordre\": 1},\n    {\"texte\": \"Océan Indien\", \"est_correcte\": false, \"ordre\": 2},\n    {\"texte\": \"Océan Pacifique\", \"est_correcte\": true, \"ordre\": 3},\n    {\"texte\": \"Océan Arctique\", \"est_correcte\": false, \"ordre\": 4}\n  ]\n}"
