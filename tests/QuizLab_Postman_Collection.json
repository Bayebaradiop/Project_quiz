						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titre\": \"Quiz de Test - Culture Générale\",\n  \"description\": \"Un quiz complet pour tester le système\",\n  \"type_quiz\": \"instantane\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/quizzes",
							"host": [
