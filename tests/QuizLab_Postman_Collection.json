		{
			"name": "2. Création Quiz",
			"item": [
				{
					"name": "Créer un quiz",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Quiz créé avec succès\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('lien_partage');",
									"    ",
