		{
			"name": "3. CAS 1 - Participation avec Invitation",
			"item": [
				{
					"name": "Envoyer une invitation",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Invitation envoyée\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('code_acces');",
									"    ",
									"    // Sauvegarder le code d'accès",
									"    pm.environment.set(\"code_acces\", jsonData.data.code_acces);",
									"    pm.environment.set(\"invitation_id\", jsonData.data.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"participant.invite@example.com\",\n  \"nom\": \"Participant\",\n  \"prenom\": \"Invité\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/invitations/quizzes/{{quiz_id}}/invitations",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"invitations",
								"quizzes",
								"{{quiz_id}}",
								"invitations"
							]
						},
						"description": "Envoie une invitation par email avec un code d'accès unique"
					}
				},
				{
					"name": "Démarrer participation (avec code)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Participation démarrée avec code\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.participation).to.have.property('id');",
									"    pm.expect(jsonData.data.participation.statut).to.equal('en_cours');",
									"    ",
									"    // Sauvegarder l'ID de participation",
									"    pm.environment.set(\"participation_id_invite\", jsonData.data.participation.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code_acces\": \"{{code_acces}}\",\n  \"email_participant\": \"participant.invite@example.com\",\n  \"nom_participant\": \"Invité Participant\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/participations/code",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"participations",
								"code"
							]
						},
						"description": "Démarre une participation avec le code d'invitation reçu par email"
					}
				},
				{
					"name": "Voir les questions (avec code)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Questions récupérées sans est_correcte\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    ",
									"    // Vérifier que est_correcte est masqué",
									"    if (jsonData.data.length > 0 && jsonData.data[0].choix_reponses) {",
									"        pm.expect(jsonData.data[0].choix_reponses[0]).to.not.have.property('est_correcte');",
									"    }",
									"    ",
									"    // Sauvegarder les IDs des choix corrects (pour le test)",
									"    // Q1: Paris, Q2: 7, Q3: Pacifique",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/quizzes/{{quiz_id}}/questions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"quizzes",
								"{{quiz_id}}",
								"questions"
							]
						},
						"description": "Récupère les questions avec leurs choix (est_correcte est masqué)"
					}
				},
				{
					"name": "Soumettre réponse 1 (Correcte)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Réponse 1 enregistrée\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participation_id\": {{participation_id_invite}},\n  \"question_id\": 1,\n  \"choix_reponse_id\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/participations/reponses",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"participations",
								"reponses"
							]
						},
						"description": "Soumet une réponse correcte (Paris)"
					}
				},
				{
					"name": "Soumettre réponse 2 (Incorrecte)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participation_id\": {{participation_id_invite}},\n  \"question_id\": 2,\n  \"choix_reponse_id\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/participations/reponses",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"participations",
								"reponses"
							]
						},
						"description": "Soumet une réponse incorrecte (5 au lieu de 7)"
					}
				},
				{
					"name": "Soumettre réponse 3 (Correcte)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participation_id\": {{participation_id_invite}},\n  \"question_id\": 3,\n  \"choix_reponse_id\": 3\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/participations/reponses",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"participations",
								"reponses"
							]
						},
						"description": "Soumet une réponse correcte (Océan Pacifique)"
					}
				},
				{
					"name": "Terminer participation (avec code)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Participation terminée - Score calculé\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.participation).to.have.property('score');",
									"    pm.expect(jsonData.data.participation).to.have.property('pourcentage');",
									"    pm.expect(jsonData.data.participation.statut).to.equal('termine');",
									"    ",
									"    console.log('Score:', jsonData.data.participation.score);",
									"    console.log('Pourcentage:', jsonData.data.participation.pourcentage + '%');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participation_id\": {{participation_id_invite}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/participations/terminer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"participations",
								"terminer"
							]
						},
						"description": "Termine la participation et calcule le score final"
					}
				}
			],
			"description": "Scénario complet : Invitation → Code d'accès → Participation → Réponses → Score"
		},
