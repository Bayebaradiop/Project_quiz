							"raw": "{\n  \"texte\": \"Quelle est la capitale de la France ?\",\n  \"duree\": 20,\n  \"ordre\": 1,\n  \"choix_reponses\": [\n    {\"texte\": \"Londres\", \"est_correcte\": false, \"ordre\": 1},\n    {\"texte\": \"Paris\", \"est_correcte\": true, \"ordre\": 2},\n    {\"texte\": \"Berlin\", \"est_correcte\": false, \"ordre\": 3},\n    {\"texte\": \"Madrid\", \"est_correcte\": false, \"ordre\": 4}\n  ]\n}"
