# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/quiz?schema=public"

# Configuration JWT
JWT_SECRET="votre_jwt_secret_tres_securise_ici_changez_en_production"
JWT_REFRESH_SECRET="votre_jwt_refresh_secret_tres_securise_changez_en_production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Configuration serveur
PORT=3000
NODE_ENV="development"

# Configuration CORS
CORS_ORIGIN="http://localhost:3000"

# Configuration bcrypt
BCRYPT_ROUNDS=12

# Configuration email SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="votre_email@gmail.com"
SMTP_PASSWORD="votre_mot_de_passe_app"
SMTP_FROM_EMAIL="noreply@quizlab.com"
SMTP_FROM_NAME="QuizLab"

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL="http://localhost:3000"

