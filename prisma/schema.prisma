generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutUtilisateur {
  actif
  inactif
}

enum Role {
  user
  admin
}

enum StatutQuiz {
  brouillon
  publie
}

enum TypeQuiz {
  instantane
  programme
}

enum StatutInvitation {
  en_attente
  accepte
  refuse
  expire
}

enum StatutParticipation {
  en_cours
  termine
  abandonne
}

model Utilisateur {
  id        Int       @id @default(autoincrement())
  prenom    String
  nom       String
  email     String    @unique
  password  String
  statut    StatutUtilisateur @default(actif)
  role      Role      @default(user)
  quizzes   Quiz[]    @relation("CreateurQuizzes")
  reponses  Reponse[]
  participations Participation[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Quiz {
  id           Int          @id @default(autoincrement())
  titre        String
  description  String?
  type_quiz    TypeQuiz
  lien_partage String        @unique
  statut       StatutQuiz    @default(brouillon)
  createur_id  Int
  createur     Utilisateur   @relation("CreateurQuizzes", fields: [createur_id], references: [id])
  questions    Question[]
  invitations  Invitation[]
  participations Participation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
}

model Question {
  id             Int        @id @default(autoincrement())
  texte          String
  duree          Int
  ordre          Int
  quiz_id        Int
  quiz           Quiz       @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  choix_reponses ChoixReponse[]
  reponses       Reponse[]  // Relation inverse pour l'ancien modèle Reponse
  reponses_participants ReponseParticipant[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
}

model ChoixReponse {
  id             Int          @id @default(autoincrement())
  question_id    Int
  texte          String
  est_correcte   Boolean      @default(false)
  ordre          Int
  question       Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  reponses_participants ReponseParticipant[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  @@index([question_id])
}

model Reponse {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  question_id    Int
  reponse_donnee String
  est_correcte   Boolean
  temps_reponse  Int?
  utilisateur    Utilisateur  @relation(fields: [utilisateur_id], references: [id])
  question       Question     @relation(fields: [question_id], references: [id])
  createdAt      DateTime     @default(now())
}

model Invitation {
  id               Int              @id @default(autoincrement())
  quiz_id          Int
  email            String
  nom              String?
  prenom           String?
  statut           StatutInvitation @default(en_attente)
  code_acces       String           @unique
  date_envoi       DateTime         @default(now())
  date_expiration  DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  
  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
  @@index([code_acces])
  @@index([email])
}

model Participation {
  id                Int       @id @default(autoincrement())
  quiz_id           Int
  utilisateur_id    Int?      // Nullable pour les participations anonymes
  email_participant String?   // Pour les anonymes
  nom_participant   String?   // Pour les anonymes
  code_acces        String?   // Si participation via invitation
  score             Int?      // Score obtenu
  score_max         Int?      // Score maximum possible
  pourcentage       Float?    // Pourcentage de réussite
  temps_total       Int?      // Temps total en secondes
  statut            StatutParticipation @default(en_cours)
  date_debut        DateTime  @default(now())
  date_fin          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  quiz              Quiz              @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  utilisateur       Utilisateur?      @relation(fields: [utilisateur_id], references: [id])
  reponses          ReponseParticipant[]
  
  @@index([quiz_id])
  @@index([utilisateur_id])
  @@index([email_participant])
  @@index([code_acces])
}

model ReponseParticipant {
  id               Int           @id @default(autoincrement())
  participation_id Int
  question_id      Int
  choix_reponse_id Int?          // ID du choix sélectionné
  texte_reponse    String?       // Pour les réponses texte libre (optionnel)
  est_correcte     Boolean
  points_obtenus   Int           @default(0)
  temps_reponse    Int?          // Temps en secondes
  createdAt        DateTime      @default(now())
  
  participation    Participation @relation(fields: [participation_id], references: [id], onDelete: Cascade)
  question         Question      @relation(fields: [question_id], references: [id])
  choix_reponse    ChoixReponse? @relation(fields: [choix_reponse_id], references: [id])
  
  @@index([participation_id])
  @@index([question_id])
}
